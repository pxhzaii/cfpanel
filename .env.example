# CF Panel 环境变量示例
# 复制为 .env 并按需修改（本地开发时使用；部署到 Cloudflare Pages 请使用页面设置里的环境变量）

# 访问面板所需的口令（必填，请换成自己的强口令）
PANEL_PASSWORD=your-secret-password

# ---- 方式一：API Token（推荐，最小权限）----
# 在 https://dash.cloudflare.com/profile/api-tokens 创建，权限见 README
CF_API_TOKEN=your-cf-api-token

# ---- 方式二：Global API Key（全权限，简单但风险更高）----
# 取消注释下面两行，注释掉上面的 CF_API_TOKEN
# CF_API_EMAIL=your-email@example.com
# CF_API_KEY=your-global-api-key
